<UserControl
    x:Class="Deyxis.UI.Controls.PrimaryActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#FF171B24" CornerRadius="16" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <Ellipse Width="9" Height="9" Fill="#FFFFB454" VerticalAlignment="Center" />
                <TextBlock
                    Foreground="#FFFFC878"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding PrimaryActivity.State}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    Foreground="White"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="{Binding PrimaryActivity.Title}" />
                <TextBlock
                    Foreground="#BFD2D7E2"
                    FontSize="14"
                    Text="{Binding PrimaryActivity.Description}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                Grid.Row="2"
                Margin="0,10,0,0"
                Foreground="#D9E8EBF2"
                FontSize="14"
                FontStyle="Italic"
                Text="{Binding CurrentLyric}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding CurrentLyricVisibility}" />

            <TextBlock
                Grid.Row="3"
                Margin="0,10,0,0"
                Foreground="#72838B9C"
                FontSize="11"
                Text="PRIMARY ACTIVITY" />
        </Grid>
    </Border>
</UserControl>
