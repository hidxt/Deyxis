<UserControl
    x:Class="Deyxis.UI.Controls.IslandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deyxis.UI.Controls">

    <Grid
        Background="Transparent"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop">
        <Border
            x:Name="RevealStrip"
            Background="#E6FFFFFF"
            CornerRadius="0,0,3,3"
            PointerEntered="RevealStrip_PointerEntered"
            Visibility="Collapsed" />
        <Border
            x:Name="CapsuleSurface"
            Background="#F20B0C10"
            BorderBrush="#35FFFFFF"
            BorderThickness="1"
            CornerRadius="22"
            PointerEntered="CapsuleSurface_PointerEntered"
            PointerExited="CapsuleSurface_PointerExited">
            <Button
                Click="CapsuleButton_Click"
                Padding="18,0"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Ellipse Width="9" Height="9" Fill="#FFFFB454" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CapsuleTitle"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Deyxis" />
                        <TextBlock
                            x:Name="HoverSummary"
                            Margin="0,2,0,0"
                            Foreground="#AFC8CDD7"
                            FontSize="11"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="#8FFFFFFF"
                        FontSize="12"
                        Text="⌄" />
                </Grid>
            </Button>
        </Border>

        <Border
            x:Name="ExpandedSurface"
            Background="#F20D1016"
            BorderBrush="#35FFFFFF"
            BorderThickness="1"
            CornerRadius="24"
            Padding="18"
            Visibility="Collapsed">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#FF7C8BFF" />
                        <TextBlock
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="昼隙 / Deyxis" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Click="SettingsButton_Click"
                        Padding="12,5"
                        Background="#18FFFFFF"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Foreground="#D9FFFFFF"
                        Content="Settings" />
                    <Button
                        Grid.Column="2"
                        Click="CollapseButton_Click"
                        Padding="12,5"
                        Background="#18FFFFFF"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Foreground="#D9FFFFFF"
                        Content="Collapse" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="1.25*,*" ColumnSpacing="12">
                    <controls:PrimaryActivityView />
                    <controls:ActivityQueueView Grid.Column="1" DataContext="{Binding Queue}" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Padding="12"
                    Background="#FF171B24"
                    CornerRadius="16"
                    Visibility="{Binding FileDropPreviewVisibility}">
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="14">
                        <Image
                            Width="160"
                            Height="96"
                            Source="{Binding FileDropPreviewSource}"
                            Stretch="UniformToFill" />
                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                            <TextBlock
                                Foreground="White"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Set this image as your wallpaper?" />
                            <TextBlock
                                Foreground="#AFC8CDD7"
                                FontSize="11"
                                Text="The preview was loaded only after local image validation."
                                TextWrapping="Wrap" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{Binding FileDropActionsVisibility}">
                                <Button
                                    Click="ConfirmWallpaperButton_Click"
                                    Padding="14,6"
                                    Content="Set wallpaper" />
                                <Button
                                    Click="CancelWallpaperButton_Click"
                                    Padding="14,6"
                                    Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
